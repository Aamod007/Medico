# ==========================================
# Medico API Server Environment Variables
# ==========================================

# Database & Cache
DATABASE_URL="postgresql://postgres:[PASSWORD]@localhost:5432/medico?schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@localhost:5432/medico?schema=public"
REDIS_URL="redis://localhost:6379"

# Server Configuration
NODE_ENV="development"
PORT=5000
API_URL="http://localhost:5000"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGIN="http://localhost:3000"

# JWT Authentication
JWT_ACCESS_SECRET="your-jwt-access-secret-min-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-min-32-chars-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Razorpay Payment Gateway (Test mode keys for development)
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourTestKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourWebhookSecretHere"

# Store & Pricing Policies
FREE_SHIPPING_THRESHOLD=500
DEFAULT_SHIPPING_FEE=40
STORE_NAME="Medico Pharmacy"
STORE_GSTIN="29AAAAA0000A1Z5"
STORE_DL_NUMBER="KA-BLR-2024-00129"
STORE_EMAIL="support@medico.health"
STORE_PHONE="+91 80 4912 3456"

# Supabase (Optional for direct API execution)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-key"
SUPABASE_JWKS_URL="https://your-project.supabase.co/auth/v1/.well-known/jwks.json"
