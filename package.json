{
  "name": "medico-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade medical e-commerce platform and online pharmacy",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api",
    "db:migrate": "npm run db:migrate --workspace=apps/api",
    "db:seed": "npm run db:seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:consistency": "node scripts/run-consistency-audit.mjs",
    "test:api": "npx vitest run tests/api --test-timeout=30000",
    "test:e2e": "npx playwright test --project=chromium",
    "test:e2e:all": "npx playwright test",
    "test:all": "npm run typecheck && npm run lint && npm run test:consistency && npm run test:api && npm run test:e2e"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/supertest": "^7.2.1",
    "autocannon": "^8.0.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.3.3",
    "supertest": "^7.3.0",
    "typescript": "^5.5.4"
  }
}
